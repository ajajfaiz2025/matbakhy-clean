// Core domain model for the AI-Powered Content Repurposing Tool.
// Mirrors section 5 ("Core Domain Model") of the architecture doc:
// source media is kept separate from derived artifacts, and mutable
// user-facing artifacts are versioned so edits and generation prompts
// stay auditable and regenerable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  editor
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum ProjectStatus {
  draft
  processing
  ready
  failed
}

enum MediaFileKind {
  source
  proxy
  rendered
}

enum MediaFileStatus {
  uploading
  uploaded
  validating
  normalized
  failed
}

enum InsightType {
  theme
  key_point
  quote
  hook
  clip_candidate
  chapter
  call_to_action
  claim
}

enum ArtifactType {
  editorial_brief
  blog_draft
  social_post
  caption
  blog_post
  social_caption
  title
  summary
  chapter_list
  short_video
  quote_card
  metadata
}

enum ArtifactStatus {
  draft
  generating
  ready
  failed
}

// Platform a social_post/caption artifact was written for. Blog
// artifacts leave this null.
enum SocialPlatform {
  x
  linkedin
  instagram
}

// Integration point for the free-trial/billing system (section 12):
// no paywall logic is enforced here, but every generated version is
// tagged so a future entitlement check can filter on it without a
// schema change.
enum ArtifactTier {
  preview
  paid
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  retrying
  dead_letter
}

enum PipelineJobType {
  normalization
  transcription
  analysis
  generation
  render
}

enum UsageEventType {
  transcription_minutes
  generation_call
  render_minutes
  export_bytes
  storage_bytes
}

enum ExportStatus {
  pending
  ready
  failed
}

// Billing and tenancy boundary. Every other resource carries a
// workspaceId so tenant isolation can be enforced and tested at the
// query boundary.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  planId    String   @map("plan_id")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  projects     Project[]
  mediaFiles   MediaFile[]
  usageEvents  UsageEvent[]
  exports      Export[]
  pipelineJobs PipelineJob[]
  renderJobs   RenderJob[]

  @@map("workspaces")
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  role        Role
  status      MembershipStatus @default(active)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("memberships")
}

// A source episode or long-form recording.
model Project {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  title          String
  status         ProjectStatus @default(draft)
  sourceMediaId  String?       @map("source_media_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMedia MediaFile?       @relation(fields: [sourceMediaId], references: [id])
  transcript Transcript?
  insights   Insight[]
  artifacts  ContentArtifact[]
  exports    Export[]

  @@index([workspaceId])
  @@map("projects")
}

// Uploaded, imported, proxy, or rendered media. The original object
// should remain immutable once normalized.
model MediaFile {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  kind        MediaFileKind
  storageKey  String           @map("storage_key")
  mimeType    String           @map("mime_type")
  durationMs  Int?             @map("duration_ms")
  checksum    String?
  status      MediaFileStatus  @default(uploading)
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([workspaceId])
  @@index([checksum])
  @@map("media_files")
}

// Generic asynchronous pipeline job (section 6-8): normalization,
// transcription, and analysis stages all report through this table so
// GET /api/v1/jobs/{id} has one place to read progress, retries, and
// dead-letter state from, regardless of which stage produced it.
model PipelineJob {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  projectId      String?         @map("project_id")
  mediaFileId    String?         @map("media_file_id")
  type           PipelineJobType
  status         JobStatus       @default(queued)
  progress       Float           @default(0)
  attempt        Int             @default(0)
  idempotencyKey String          @unique @map("idempotency_key")
  messageCode    String?         @map("message_code")
  error          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@map("pipeline_jobs")
}

// Full speech-to-text result for a project. One transcript per project;
// TranscriptSegment rows hold the searchable timed units.
model Transcript {
  id         String   @id @default(cuid())
  projectId  String   @unique @map("project_id")
  provider   String
  language   String
  confidence Float?

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String  @id @default(cuid())
  transcriptId String  @map("transcript_id")
  startMs      Int     @map("start_ms")
  endMs        Int     @map("end_ms")
  text         String
  speaker      String?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

// Extracted theme, key point, quote, hook, or candidate moment — one
// atomic, independently queryable item from the Editorial Brief
// (section 6.4.2). segmentIds is the full evidence set; startMs/endMs
// is the min/max span across that evidence for timeline display.
// Retains provenance so "where did this insight come from?" is always
// answerable without re-running extraction.
model Insight {
  id         String      @id @default(cuid())
  projectId  String      @map("project_id")
  type       InsightType
  text       String
  startMs    Int         @map("start_ms")
  endMs      Int         @map("end_ms")
  segmentIds String[]    @map("segment_ids")
  score      Float?
  rationale  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("insights")
}

// Blog, caption, title, quote, or short-video draft. Immutable
// ArtifactVersion rows hold the actual generated/edited content.
model ContentArtifact {
  id               String          @id @default(cuid())
  projectId        String          @map("project_id")
  type             ArtifactType
  platform         SocialPlatform?
  language         String
  status           ArtifactStatus  @default(draft)
  sourceRefs       String[]        @map("source_refs")
  currentVersionId String?         @unique @map("current_version_id")

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       ArtifactVersion[] @relation("ArtifactVersions")
  currentVersion ArtifactVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  renderJobs     RenderJob[]

  // One artifact per (project, type, platform, language) — enforced in
  // application logic (find-or-create inside a transaction), same
  // simplification as the editorial_brief artifact from step 6.
  @@index([projectId, type, platform, language])
  @@map("content_artifacts")
}

model ArtifactVersion {
  id                  String       @id @default(cuid())
  artifactId          String       @map("artifact_id")
  // The specific Editorial Brief version this was generated from
  // (null for the editorial_brief artifact itself). Lets a generated
  // artifact be traced back to exactly which brief produced it, even
  // after the brief is later regenerated.
  sourceBriefVersionId String?     @map("source_brief_version_id")
  tier                ArtifactTier @default(preview)
  body                Json
  parameters          Json         @default("{}")
  model               String?
  createdBy           String       @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at")

  artifact        ContentArtifact  @relation("ArtifactVersions", fields: [artifactId], references: [id], onDelete: Cascade)
  current         ContentArtifact? @relation("CurrentVersion")
  sourceBriefVersion ArtifactVersion?  @relation("BriefSources", fields: [sourceBriefVersionId], references: [id])
  generatedFrom      ArtifactVersion[] @relation("BriefSources")

  @@index([artifactId])
  @@map("artifact_versions")
}

// Requested video or audio transformation for a short-video artifact
// (Step 8: CandidateClip -> FFmpeg -> 9:16 MP4). Domain-specific
// bookkeeping record analogous to Transcript for transcription jobs —
// the generic PipelineJob row (type "render") is what GET
// /api/v1/jobs/{id} reads; this table holds what's specific to a
// render: which candidate clip, from which pinned Editorial Brief
// version, and with what deterministic config.
model RenderJob {
  id       String @id @default(cuid())
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  artifactId  String @map("artifact_id")

  // The candidate clip's local id within the pinned Editorial Brief
  // version (e.g. "clip_1") — only unique within that one brief
  // version, never globally, so idempotency/lookups always pin
  // sourceBriefVersionId alongside it (never resolved against
  // "whatever the current brief is" at render time).
  candidateClipId      String @map("candidate_clip_id")
  sourceBriefVersionId String @map("source_brief_version_id")
  sourceMediaId        String @map("source_media_id")

  // sourceMedia + candidateClip (pinned to a brief version) + the
  // deterministic render config together define one idempotent render
  // request — a retried/duplicate request reuses this row instead of
  // re-rendering.
  idempotencyKey String @unique @map("idempotency_key")
  // Deterministic render-strategy version tag (e.g.
  // "vertical-9x16-v1") — NOT a selectable template; there is exactly
  // one rendering strategy for MVP. Documents which strategy version
  // produced this render, since the strategy may evolve later.
  template String
  config   Json   @default("{}")

  status        JobStatus @default(queued)
  progress      Float     @default(0)
  attempt       Int       @default(0)
  outputMediaId String?   @map("output_media_id")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact  ContentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([workspaceId])
  @@map("render_jobs")
}

// Billable or quota-relevant activity. idempotencyKey prevents a retry
// from double-charging usage.
model UsageEvent {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  eventType      UsageEventType @map("event_type")
  quantity       Float
  idempotencyKey String         @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventType])
  @@map("usage_events")
}

// Downloadable package or publishing attempt.
model Export {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  projectId   String       @map("project_id")
  status      ExportStatus @default(pending)
  manifestKey String?      @map("manifest_key")
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("exports")
}

// External event for billing or integrations. eventId + provider is
// unique so webhook signature replays cannot be processed twice.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @map("event_id")
  payloadHash String    @map("payload_hash")
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}
