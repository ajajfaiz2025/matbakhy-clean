# Recipe bot (existing feature) — get a key at https://openrouter.ai/
OPENROUTER_API_KEY=

# Content-repurposing tool (see docs/architecture.md)
# Postgres connection string for Prisma. Section 4.1 recommends
# PostgreSQL as the primary database.
DATABASE_URL="postgresql://user:password@localhost:5432/matbakhy?schema=public"

# Redis, used by BullMQ for the normalization/transcription job queue
# (section 4.1, "Job processing").
REDIS_URL="redis://localhost:6379"

# Optional: enables the real Whisper-based transcription provider
# (lib/transcription/openaiProvider.ts). Without it, the pipeline uses
# a deterministic mock provider (see lib/transcription/mockProvider.ts).
OPENAI_API_KEY=
